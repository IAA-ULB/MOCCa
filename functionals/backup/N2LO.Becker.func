# (local, central) N2LO functional with Jmunu terms optional
# Useable for SN2LO1, ....
! (N) LO parameters
t0 ;  x0 ; t1 ;  x1 ; t2 ; x2 ; t3; x3 ; wso ; wsoq ; sigma ; CT0 ; CT1
! N2LO parameters
t1n2 ; x1n2 ; t2n2 ; x2n2
! Pairing strengths
Vn ; Vp ; alpha ; sigmap
!TERMS
!----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
! Time-even, central, LO terms
E_D_I_I_D_I_I            ; Cc(t0,x0,+1,0,0)                                     ;         Cc(t0,x0,+1,0,1)
E_D_I_I_D_I_I_DD         ;+1.0/6.0*Cc(t3,x3,+1,0,0)                             ; +1.0/6.0*Cc(t3,x3,+1,0,1)                              ;  (sum(D_I_I,2)**(sigma)) ;  D_I_I ; sigma*((sum(D_I_I,2)+eps)**(sigma-1)) ; sigma ;
!----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
! Time-odd, central LO terms  
E_D_I_Sm_D_I_Sm          ; Cc(t0,x0,+1,1,0)                                     ;         Cc(t0,x0,+1,1,1)
E_D_I_Sm_D_I_Sm_DD       ;+1.0/6.0*Cc(t3,x3,+1,1,0)                             ; +1.0/6.0*Cc(t3,x3,+1,1,1)                              ;  (sum(D_I_I,2)**(sigma)) ;  D_I_I ; sigma*((sum(D_I_I,2)+eps)**(sigma-1)) ; sigma ;
!----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
! Time-even, central NLO terms     
E_D_I_I_D_Nm_Nm          ;+1.0/2.0*Cc(t1,x1,+1,0,0) + 1.0/2.0*Cc(t2,x2,-1,0,0)  ; +1.0/2.0*Cc(t1,x1,+1,0,1) + 1.0/2.0*Cc(t2,x2,-1,0,1)
E_D_I_I_Lap_D_I_I        ;-3.0/8.0*Cc(t1,x1,+1,0,0) + 1.0/8.0*Cc(t2,x2,-1,0,0)  ; -3.0/8.0*Cc(t1,x1,+1,0,1) + 1.0/8.0*Cc(t2,x2,-1,0,1) 
! Time-odd
E_C_I_Nm_C_I_Nm          ; -1.0/2.0*Cc(t1,x1,+1,0,0) - 1.0/2.0*Cc(t2,x2,-1,0,0) ; -1.0/2.0*Cc(t1,x1,+1,0,1) - 1.0/2.0*Cc(t2,x2,-1,0,1)
E_D_I_Sm_Lap_D_I_Sm      ;-3.0/8.0*Cc(t1,x1,+1,1,0) + 1.0/8.0*Cc(t2,x2,-1,1,0)  ; -3.0/8.0*Cc(t1,x1,+1,1,1) + 1.0/8.0*Cc(t2,x2,-1,1,1) 
!----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
! Time-even spin-orbit (NLO)
E_D_I_I_Derm_C_I_NxmSxm  ;  -wso/2.0 - wsoq/4.0     ; - wsoq/4.0
! Time-odd spin-orbit (NLO)
E_C_I_Nm_Derxm_D_I_Sxm   ;  -wso/2.0 - wsoq/4.0     ; - wsoq/4.0
!----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
! SLy5-like JmnJmn term (NLO)
E_C_I_NmSk_C_I_NmSk      ; -CT0  ;  -CT1
! Its time-odd companion
E_D_I_Sm_D_Nk_NkSm       ; +CT0  ;  +CT1
!-------------------------------------------------------------------------------
! Time-even, central N2LO terms
! Without spin
! - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
! DrhoDrho, rhoQ, tau^2, tau_mn^2, taumn dmdnrho
E_Lap_D_I_I_Lap_D_I_I     ; +3.0/16.0*Cc(t1n2,x1n2,+1,0,0) - 1.0/16.0*Cc(t2n2,x2n2,-1,0,0) ; +3.0/16.0*Cc(t1n2,x1n2,+1,0,1) - 1.0/16.0*Cc(t2n2,x2n2,-1,0,1)
E_D_I_I_D_NmNm_NkNk       ; +1.0/4.0 *Cc(t1n2,x1n2,+1,0,0) + 1.0/4.0 *Cc(t2n2,x2n2,-1,0,0) ; +1.0/4.0 *Cc(t1n2,x1n2,+1,0,1) + 1.0/4.0 *Cc(t2n2,x2n2,-1,0,1)
E_D_Nm_Nm_D_Nk_Nk         ; +1.0/4.0 *Cc(t1n2,x1n2,+1,0,0) + 1.0/4.0 *Cc(t2n2,x2n2,-1,0,0) ; +1.0/4.0 *Cc(t1n2,x1n2,+1,0,1) + 1.0/4.0 *Cc(t2n2,x2n2,-1,0,1)
E_D_Nm_Nk_D_Nm_Nk         ; +2.0/4.0 *Cc(t1n2,x1n2,+1,0,0) + 2.0/4.0 *Cc(t2n2,x2n2,-1,0,0) ; +2.0/4.0 *Cc(t1n2,x1n2,+1,0,1) + 2.0/4.0 *Cc(t2n2,x2n2,-1,0,1)
E_D_Nm_Nk_Derm_Derk_D_I_I ; -2.0/4.0 *Cc(t1n2,x1n2,+1,0,0) - 2.0/4.0 *Cc(t2n2,x2n2,-1,0,0) ; -2.0/4.0 *Cc(t1n2,x1n2,+1,0,1) - 2.0/4.0 *Cc(t2n2,x2n2,-1,0,1)
! - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
! With spin
! ImT^2, JmnVmn
E_C_Nm_NkSo_C_Nm_NkSo     ; -2.0/4.0 *Cc(t1n2,x1n2,+1,1,0) - 2.0/4.0 *Cc(t2n2,x2n2,-1,1,0) ; -2.0/4.0 *Cc(t1n2,x1n2,+1,1,1) - 2.0/4.0 *Cc(t2n2,x2n2,-1,1,1)
E_C_I_NmSo_C_Nk_NkNmSo    ; -1.0     *Cc(t1n2,x1n2,+1,1,0) - 1.0     *Cc(t2n2,x2n2,-1,1,0) ; -1.0     *Cc(t1n2,x1n2,+1,1,1) - 1.0     *Cc(t2n2,x2n2,-1,1,1)
!-------------------------------------------------------------------------------
! Time-odd, central N2LO terms
! With spin
E_Lap_D_I_Sm_Lap_D_I_Sm       ; +3.0/16.0*Cc(t1n2,x1n2,+1,1,0) - 1.0/16.0*Cc(t2n2,x2n2,-1,1,0) ; +3.0/16.0*Cc(t1n2,x1n2,+1,1,1) - 1.0/16.0*Cc(t2n2,x2n2,-1,1,1)
E_D_I_So_D_NkNk_NmNmSo        ; +1.0/4.0 *Cc(t1n2,x1n2,+1,1,0) + 1.0/4.0 *Cc(t2n2,x2n2,-1,1,0) ; +1.0/4.0 *Cc(t1n2,x1n2,+1,1,1) + 1.0/4.0 *Cc(t2n2,x2n2,-1,1,1)
!E_D_Nm_NmSo_D_Nk_NkSo         ; +1.0/4.0 *Cc(t1n2,x1n2,+1,1,0) + 1.0/4.0 *Cc(t2n2,x2n2,-1,1,0) ; +1.0/4.0 *Cc(t1n2,x1n2,+1,1,1) + 1.0/4.0 *Cc(t2n2,x2n2,-1,1,1)
!E_D_Nm_NkSo_D_Nm_NkSo         ; +2.0/4.0 *Cc(t1n2,x1n2,+1,1,0) + 2.0/4.0 *Cc(t2n2,x2n2,-1,1,0) ; +2.0/4.0 *Cc(t1n2,x1n2,+1,1,1) + 2.0/4.0 *Cc(t2n2,x2n2,-1,1,1)
!E_D_Nm_NkSo_Derm_Derk_D_I_So  ; -2.0/4.0 *Cc(t1n2,x1n2,+1,1,0) - 2.0/4.0 *Cc(t2n2,x2n2,-1,1,0) ; -2.0/4.0 *Cc(t1n2,x1n2,+1,1,1) - 2.0/4.0 *Cc(t2n2,x2n2,-1,1,1)
! Without spin
E_C_Nm_Nk_C_Nm_Nk             ; -2.0/4.0 *Cc(t1n2,x1n2,+1,0,0) - 2.0/4.0 *Cc(t2n2,x2n2,-1,0,0) ; -2.0/4.0 *Cc(t1n2,x1n2,+1,0,1) - 2.0/4.0 *Cc(t2n2,x2n2,-1,0,1)
E_Derm_C_I_Nm_Derk_C_I_Nk     ; -1.0/4.0 *Cc(t1n2,x1n2,+1,0,0) - 1.0/4.0 *Cc(t2n2,x2n2,-1,0,0) ; -1.0/4.0 *Cc(t1n2,x1n2,+1,0,1) - 1.0/4.0 *Cc(t2n2,x2n2,-1,0,1)
E_C_I_Nm_C_Nk_NkNm            ; -1.0     *Cc(t1n2,x1n2,+1,0,0) - 1.0     *Cc(t2n2,x2n2,-1,0,0) ; -1.0     *Cc(t1n2,x1n2,+1,0,1) - 1.0     *Cc(t2n2,x2n2,-1,0,1)
!-------------------------------------------------------------------------------
! Pairing interaction 
E_DP_I_I_DP_I_I          ;  Vn/4.0 ; Vp/4.0 ;  (1 - alpha * (sum(D_I_I,2)/0.16)**(sigmap)) ;  D_I_I ; 0.0 ; 0.0 ;                                            
E_CP_I_I_CP_I_I          ;  Vn/4.0 ; Vp/4.0 ;  (1 - alpha * (sum(D_I_I,2)/0.16)**(sigmap)) ;  D_I_I ; 0.0 ; 0.0 ;   
