# N2LO time-even functional
# includes density dependence 
!--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
! NLO terms
E_D_I_I_D_I_I                    ;                        ;        ;                                   ;      ; +3.0/8.0*t0+0*t0*x0+0*t3+0*t3*x3                                    ; -1.0/8.0*t0-0.25*t0*x0+0*t3+0*t3*x3 
E_D_I_I_D_I_I_DD                 ; (sum(D_I_I,2)**(yt3a)) ;  D_I_I ; yt3a*((sum(D_I_I,2)+eps)**(yt3a-1)) ; yt3a ; 3.0_dp/48.0_dp * t3                                                 ; - 1.0_dp/24.0_dp * t3 * (0.5_dp + x3) 
E_D_I_I_D_Nm_Nm                  ;                        ;        ;                                   ;      ; +3.0/16.0*t1+0*t1*x1+5.0/16.0*t2+1/4.0*t2*x2                        ; -1.0/16.0*t1-1.0/8.0*t1*x1+1.0/16.0*t2+1.0/8.0*t2*x2 
E_D_I_I_Lap_D_I_I                ;                        ;        ;                                  ;      ; -9.0/64.0*t1+0*t1*x1+5.0/64.0*t2+1/16.0*t2*x2                       ; +3.0/64.0*t1+3.0/32 *t1*x1+1.0/64.0*t2+1.0/32 *t2*x2 
!--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
! Time-even spin-orbit
E_D_I_I_Derm_C_I_NxmSxm          ;                        ;        ;                               ;      ; -wso/2.0 - wsoq/4.0                                                 ; - wsoq/4.0
!--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
! SLy5-like JmnJmn term
E_C_I_NmSk_C_I_NmSk              ;                        ;        ;                              ;       ;  -(1.0_dp/8.0_dp) * (t1*x1 + t2*x2) + (1.0_dp/16.0_dp) * (t1 - t2)  ; (1.0_dp/16.0_dp) * (t1 - t2)
!--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
! N2LO terms
! DrhoDrho, rhoQ, tau^2, tau_mn^2, taumn dmdnrho, ImT^2, JmnVmn
E_Lap_D_I_I_Lap_D_I_I            ;                        ;        ;                               ;      ; +9/128.0*t1n2+0*t1n2 * x1n2-5/128.0*t2n2-4/128.0*t2n2 * x2n2 ; -3/128.0*t1n2-3/64.0*t1n2 * x1n2-1/128.0*t2n2-1/64.0*t2n2 * x2n2 
E_D_I_I_D_NmNm_NkNk              ;                        ;        ;                               ;      ; +3/32.0*t1n2+0*t1n2 * x1n2+5/32.0*t2n2+1/8.0*t2n2 * x2n2     ; -1/32.0*t1n2-1/16.0*t1n2 * x1n2+1/32.0*t2n2+1/16.0*t2n2 * x2n2 
E_D_Nm_Nm_D_Nk_Nk                ;                        ;        ;                               ;      ;+3/32.0*t1n2+0*t1n2 * x1n2+5/32.0*t2n2+1/8.0*t2n2 * x2n2      ; -1/32.0*t1n2-1/16.0*t1n2 * x1n2+1/32.0*t2n2+1/16.0*t2n2 * x2n2 
E_D_Nm_Nk_D_Nm_Nk                ;                        ;        ;                               ;       ;+6/32.0*t1n2+0*t1n2 * x1n2+10/32.0*t2n2+2/8.0*t2n2 * x2n2    ; -2/32.0*t1n2-2/16.0*t1n2 * x1n2+2/32.0*t2n2+2/16.0*t2n2 * x2n2 
E_D_Nm_Nk_Derm_Derk_D_I_I        ;                        ;        ;                               ;      ;-6/32.0*t1n2+0*t1n2 * x1n2-10/32.0*t2n2-2/8.0*t2n2 * x2n2     ; +2/32.0*t1n2+2/16.0*t1n2 * x1n2-2/32.0*t2n2-2/16.0*t2n2 * x2n2 
E_C_Nm_NoSk_C_Nm_NoSk            ;                        ;        ;                               ;      ;+2/32.0*t1n2-2/16.0*t1n2*x1n2-2/32.0*t2n2-2/16.0*t2n2*x2n2   ; 2/32.0*t1n2+0*t1n2 * x1n2-2/32.0*t2n2+0*t2n2 * x2n2 
E_C_I_NmSo_C_Nk_NkNmSo           ;                        ;        ;                               ;      ;+4/32.0*t1n2-4/16.0*t1n2*x1n2-4/32.0*t2n2-4/16.0*t2n2*x2n2   ;+4/32.0*t1n2+0*t1n2 * x1n2-4/32.0*t2n2+0*t2n2 * x2n2 
!---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
! N2LO tensor
!
! JmunuVmunu  
! Note this term is already present before, and here we trick Hephaestos into thinking it is a different term by using different summation indices
E_C_I_NmSq_C_Nk_NkNmSq           ;                        ;        ;                               ;      ; 1.0/4.0*(ten2 + 3 * ton2)*  4  ; -1.0/4.0*(ten2 - 3 * ton2)*  4
! Im Tmnk  (Minus sign through imaginary part!)   
! Note this term is already present before, and here we trick Hephaestos into thinking it is a different term by using different summation indices
E_C_Nm_NqSk_C_Nm_NqSk            ;                        ;        ;                               ;      ; 1.0/4.0*(ten2 + 3 * ton2)*( 2) ; -1.0/4.0*(ten2 - 3 * ton2)*(2)
! JmumuVnunu
E_C_I_NmSm_C_Nk_NkNoSo           ;                        ;        ;                               ;      ; 1.0/4.0*(ten2 + 3 * ton2)*(-3) ; -1.0/4.0*(ten2 - 3 * ton2)*(-3)
! JmunuVnumu
E_C_I_NmSo_C_Nk_NkNoSm           ;                        ;        ;                               ;      ; 1.0/4.0*(ten2 + 3 * ton2)*(-3) ; -1.0/4.0*(ten2 - 3 * ton2)*(-3)
! J_munu V_munukk 
E_C_I_NmSk_C_Nm_NkNoSo           ;                        ;        ;                               ;      ; 1.0/4.0*(ten2 + 3 * ton2)*(-3)     ; -1.0/4.0*(ten2 - 3 * ton2)*(-3)
! J_munu V_numukk 
E_C_I_NmSk_C_Nk_NmNoSo           ;                        ;        ;                               ;      ; 1.0/4.0*(ten2 + 3 * ton2)*(-3)     ; -1.0/4.0*(ten2 - 3 * ton2)*(-3)
! Jmumu Lap Jnunu
E_C_I_NmSm_Lap_C_I_NkSk          ;                        ;        ;                               ;      ; 1.0/4.0*(ten2 + 3 * ton2)*( 3/4.0) ; -1.0/4.0*(ten2 - 3 * ton2)*( 3/4.0)
! Jmunu Lap Jnumu
E_C_I_NmSk_Lap_C_I_NkSm          ;                        ;        ;                               ;      ; 1.0/4.0*(ten2 + 3 * ton2)*( 3/4.0) ; -1.0/4.0*(ten2 - 3 * ton2)*( 3/4.0)
! Der_mu Jmunu Der_nu Lap Jkaka
E_Derm_C_I_NmSk_Derk_C_I_NoSo    ;                        ;        ;                               ;      ; 1.0/4.0*(ten2 + 3 * ton2)*(-3/2.0) ; -1.0/4.0*(ten2 - 3 * ton2)*(-3/2.0)
