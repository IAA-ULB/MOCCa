#-------------------------------------------------------------------------------
# Functional file for the fits in Brussels, including time-odd terms.
# Note:
#   *) Optional JmnJmn and s x j terms 
#   *) No S Delta S/ D_I_S_Lap_D_I_S term to suppress numerical instabilities
#   *) The force_switch parameter is still here for backwards compatibility,
#      but has no effect at the moment.
#-------------------------------------------------------------------------------
! Particle-hole parameters that are active all the time
t0 ;  x0 ; t1 ;  x1 ; t2 ; x2 ; t3; x3;  wso ;  sigma 
! Particle-hole parameters that are only active when force_switch=0
CT0; CT1 ; CSDS0; CSDS1; wsoq
! Particle-particle parameters
Vn ; Vp ; alpha ; sigmap
! Scale factor for the time-odd channel
scaleTO 
! Switch to use either the DD-force or the ULB-pairing-like
! Currently inactive
force_switch 
!TERMS
#-------------------------------------------------------------------------------
# Particle-hole part, ordinary NLO SKYRME
!-------------------------------------------------------------------------------
! Central LO terms     
! time-even
E_D_I_I_D_I_I            ; Cc(t0,x0,+1,0,0)                                     ;          Cc(t0,x0,+1,0,1)
E_D_I_I_D_Nm_Nm          ;+1.0/2.0*Cc(t1,x1,+1,0,0) + 1.0/2.0*Cc(t2,x2,-1,0,0)  ; +1.0/2.0*Cc(t1,x1,+1,0,1) + 1.0/2.0*Cc(t2,x2,-1,0,1)
! time-odd
E_D_I_Sm_D_I_Sm          ; scaleTO * Cc(t0,x0,+1,1,0)                                     ; scaleTO *        Cc(t0,x0,+1,1,1)
E_D_I_Sm_D_I_Sm_DD       ; scaleTO * +1.0/6.0*Cc(t3,x3,+1,1,0)                            ; scaleTO * +1.0/6.0*Cc(t3,x3,+1,1,1)                              ;  (sum(D_I_I,2)**(sigma)) ;  D_I_I ; sigma*((sum(D_I_I,2)+eps)**(sigma-1)) ; sigma ;
!-------------------------------------------------------------------------------
! Central NLO terms
! time-even     
E_D_I_I_Lap_D_I_I        ;-3.0/8.0*Cc(t1,x1,+1,0,0) + 1.0/8.0*Cc(t2,x2,-1,0,0)  ; -3.0/8.0*Cc(t1,x1,+1,0,1) + 1.0/8.0*Cc(t2,x2,-1,0,1) 
E_D_I_I_D_I_I_DD         ;+1.0/6.0*Cc(t3,x3,+1,0,0)                             ; +1.0/6.0*Cc(t3,x3,+1,0,1)                              ;  (sum(D_I_I,2)**(sigma)) ;  D_I_I ; sigma*((sum(D_I_I,2)+eps)**(sigma-1)) ; sigma ;
E_C_I_NmSk_C_I_NmSk      ; - CT0  ; - CT1
! time-odd
E_C_I_Nm_C_I_Nm          ;-scaleTO *1.0/2.0*Cc(t1,x1,+1,0,0) -scaleTO * 1.0/2.0*Cc(t2,x2,-1,0,0)  ; -scaleTO *1.0/2.0*Cc(t1,x1,+1,0,1) - scaleTO *1.0/2.0*Cc(t2,x2,-1,0,1)
E_D_I_Sm_Lap_D_I_Sm      ; scaleTO * CSDS0 ; scaleTO * CSDS1 
E_D_I_Sm_D_Nk_NkSm       ;  +scaleTO *CT0  ; +scaleTO * CT1
!-------------------------------------------------------------------------------
! NLO spin-orbit
! time-even
E_D_I_I_Derm_C_I_NxmSxm  ;  -wso/2.0 - wsoq/4.0     ;  -wsoq/4.0
! time-odd
E_C_I_Nm_Derxm_D_I_Sxm   ;  -scaleTO *wso/2.0 - scaleTO *wsoq/4.0     ; - scaleTO *wsoq/4.0
!-------------------------------------------------------------------------------
! Pairing interaction 
! Time-even pairing density
E_DP_I_I_DP_I_I          ;  Vn/4 ; Vp/4 ;  (1 - alpha * (sum(D_I_I,2)/0.16)**(sigmap)) ;  D_I_I ; 0.0 ; 0.0 ; 
! Time-odd pairing density                  
E_CP_I_I_CP_I_I          ; scaleTO * Vn/4 ; scaleTO *Vp/4 ;  (1 - alpha * (sum(D_I_I,2)/0.16)**(sigmap)) ;  D_I_I ; 0.0 ; 0.0 ;                   
