# NLO Skyrme functional 
# -> with time-off terms
# -> without tensor terms
# -> Jmunu and sDs terms optional
#
! Particle-hole parameters
t0 ;  x0 ; t1 ;  x1 ; t2 ; x2 ; t3; x3;  wso ; wsoq ; sigma ; CT0 ; CT1 ; CSDS0 ; CSDS1
! Pairing strengths
Vn ; Vp ; alpha ; sigmap
!TERMS
!-------------------------------------------------------------------------------
! Central, LO terms   
! Time-even  
E_D_I_I_D_I_I            ; Cc(t0,x0,+1,0,0)                                     ;         Cc(t0,x0,+1,0,1)

