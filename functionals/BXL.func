#-----------------------------------------------------------------------------------------------------------------------
# Functional file for the NLO fits in Brussels.
# Things to be noted
#   - Two spin-orbit strengths
#   - Optional JmnJmn terms and s Delta s terms for the standard EDF
#   - Optional microscopic pairing treatment (see BSkG3 publication)
#   - ATTENTION: there is no implementation at all of the density-dependent 
#      J^2, s Delta s and (nabla s)^2 terms.
# 
# BSkG1 : G. Scamps, S. Goriely, E. Olsen, M. Bender, W. Ryssens 
#         Skyrme-Hartree-Fock-Bogoliubov mass models on a 3D mesh: effect of triaxial shape. 
#         European Physical Journal A, 57(12), 333 (2021). 
#         https://doi.org/10.1140/epja/s10050-021-00642-1
#
# BSkG2 : W. Ryssens, G. Scamps, S. Goriely and M. Bender
#         Skyrme-Hartree-Fock-Bogoliubov mass models on a 3D mesh: II. Time-reversal symmetry breaking.
#         European Physical Journal A 58, 246 (2022).
#         https://doi.org/10.1140/epja/s10050-022-00894-5
# 
# BSkG3 : G. Grams, W. Ryssens, G. Scamps, S. Goriely and N. Chamel
#         Skyrme-Hartree-Fock-Bogoliubov mass models on a 3D mesh: III. From atomic nuclei to neutron stars.
#         
#         The formulas for the t4/t5 extension of the standard EDF were taken from:
#         A. Pastore, M. Martini, D. Davesne, J. Navarro, S. Goriely and N. Chamel,
#         Linear response theory and neutrino mean free path using Brussels-Montreal Skyrme functionals,
#         Physical Review C 90, 025804 (2014)
#         https://doi.org/10.1103/PhysRevC.89.044302
#
#------------------------------------------------------------------------------------------------------------------------
! Particle-hole parameters
R t0 ;R  x0 ;R t1   ;R   x1 ;R t2  ;R x2 ;R t3;R x3;R t4 ;R t5;R x4 ;R x5;R wso;R sigma;R beta ;R  gamma 
R CT0;R CT1 ;R CSDS0;R CSDS1;R wsoq
! Particle-particle parameters
R Vn ;R  Vp ;R alpha;R sigmap;R kappa_n;R kappa_p;R Vnm;R Vpm
! Microscopic pairing options
I ptype ;I interpolationtype;I integrationtype
!TERMS
!---------------------------------------------------------------------------------------------------------------
! Central, LO terms   
! Time-even  
! Term                         ! Coupling constant                                  ! DD_pow! isospin indices
E_D_I_I_D_I_I                  ; Cc(t0,x0,+1,0,0)                                   ;   1   ; 0 ; 0
E_D_I_I_D_I_I                  ; Cc(t0,x0,+1,0,1)                                   ;   1   ; 1 ; 1
E_D_I_I_D_I_I_D_I_I            ; +1.0/6.0*Cc(t3,x3,+1,0,0)                          ; sigma ; 0 ; 0 ; 0
E_D_I_I_D_I_I_D_I_I            ; +1.0/6.0*Cc(t3,x3,+1,0,1)                          ; sigma ; 0 ; 1 ; 1
! Time-odd  
E_D_I_Sm_D_I_Sm                ; Cc(t0,x0,+1,1,0)                                   ;   1   ; 0 ; 0
E_D_I_Sm_D_I_Sm                ; Cc(t0,x0,+1,1,1)                                   ;   1   ; 1 ; 1
E_D_I_I_D_I_Sm_D_I_Sm          ; +1.0/6.0*Cc(t3,x3,+1,1,0)                          ; sigma ; 0 ; 0 ; 0
E_D_I_I_D_I_Sm_D_I_Sm          ; +1.0/6.0*Cc(t3,x3,+1,1,1)                          ; sigma ; 0 ; 1 ; 1
!---------------------------------------------------------------------------------------------------------------
! Central, NLO terms
! Time-even  
! Term                         ! Coupling constant                                  ! DD_pow! isospin indices
E_D_I_I_D_Nm_Nm                ; +1.0/2.0*Cc(t1,x1,+1,0,0)+1.0/2.0*Cc(t2,x2,-1,0,0) ;   1   ; 0 ; 0
E_D_I_I_D_Nm_Nm                ; +1.0/2.0*Cc(t1,x1,+1,0,1)+1.0/2.0*Cc(t2,x2,-1,0,1) ;   1   ; 1 ; 1
E_D_I_I_Lap_D_I_I              ; -3.0/8.0*Cc(t1,x1,+1,0,0)+1.0/8.0*Cc(t2,x2,-1,0,0) ;   1   ; 0 ; 0
E_D_I_I_Lap_D_I_I              ; -3.0/8.0*Cc(t1,x1,+1,0,1)+1.0/8.0*Cc(t2,x2,-1,0,1) ;   1   ; 1 ; 1
E_C_I_NmSk_C_I_NmSk            ; -CT0                                               ;   1   ; 0 ; 0
E_C_I_NmSk_C_I_NmSk            ; -CT1                                               ;   1   ; 1 ; 1
! Time-odd
E_C_I_Nm_C_I_Nm                ; -1.0/2.0*Cc(t1,x1,+1,0,0)-1.0/2.0*Cc(t2,x2,-1,0,0) ;   1   ; 0 ; 0
E_C_I_Nm_C_I_Nm                ; -1.0/2.0*Cc(t1,x1,+1,0,1)-1.0/2.0*Cc(t2,x2,-1,0,1) ;   1   ; 1 ; 1
E_D_I_Sm_Lap_D_I_Sm            ; +CSDS0                                             ;   1   ; 0 ; 0
E_D_I_Sm_Lap_D_I_Sm            ; +CSDS1                                             ;   1   ; 1 ; 1
E_D_I_Sm_D_Nk_NkSm             ; +CT0                                               ;   1   ; 0 ; 0
E_D_I_Sm_D_Nk_NkSm             ; +CT1                                               ;   1   ; 1 ; 1
!-------------------------------------------------------------------------------------------------------------------------
! Central NLO terms from t4/5
! Time-even  
! Term                               ! Coupling constant                            ! DD_pow! isospin indices
E_D_I_I_D_I_I_D_Nm_Nm                ;   1.0/2.0 * CC(t4,x4,+1,0,0)                 ;   beta    ; 0 ; 0 ; 0
E_D_I_I_D_I_I_D_Nm_Nm                ;   1.0/2.0 * CC(t4,x4,+1,0,1)                 ;   beta    ; 0 ; 1 ; 1
E_D_I_I_D_I_I_D_Nm_Nm                ;   1.0/2.0 * CC(t5,x5,-1,0,0)                 ;   gamma   ; 0 ; 0 ; 0
E_D_I_I_D_I_I_D_Nm_Nm                ;   1.0/2.0 * CC(t5,x5,-1,0,1)                 ;   gamma   ; 0 ; 1 ; 1
E_D_I_I_Derm_D_I_I_Derm_D_I_I        ;  +3.0/8.0 * CC(t4,x4,+1,0,0)                 ;   beta    ; 0 ; 0 ; 0
E_D_I_I_Derm_D_I_I_Derm_D_I_I        ;  +3.0/8.0 * CC(t4,x4,+1,0,1)                 ;   beta    ; 0 ; 1 ; 1
E_D_I_I_Derm_D_I_I_Derm_D_I_I        ;  -1.0/8.0 * CC(t5,x5,-1,0,0)                 ;   gamma   ; 0 ; 0 ; 0
E_D_I_I_Derm_D_I_I_Derm_D_I_I        ;  -1.0/8.0 * CC(t5,x5,-1,0,1)                 ;   gamma   ; 0 ; 1 ; 1
E_D_I_I_Derm_D_I_I_D_I_I_Derm_D_I_I  ;  +1.0/4.0 * CC(t4,x4,+1,0,0)*beta            ;   beta-1  ; 0 ; 0 ; 0 ; 0
E_D_I_I_Derm_D_I_I_D_I_I_Derm_D_I_I  ;  +1.0/4.0 * CC(t4,x4,+1,0,1)*beta            ;   beta-1  ; 0 ; 0 ; 1 ; 1 
! Time-odd
E_D_I_I_C_I_Nm_C_I_Nm                ;  -1.0/2.0 * CC(t4,x4,+1,0,0)                 ;   beta    ; 0 ; 0 ; 0
E_D_I_I_C_I_Nm_C_I_Nm                ;  -1.0/2.0 * CC(t4,x4,+1,0,1)                 ;   beta    ; 0 ; 1 ; 1
E_D_I_I_C_I_Nm_C_I_Nm                ;  -1.0/2.0 * CC(t5,x5,-1,0,0)                 ;   gamma   ; 0 ; 0 ; 0
E_D_I_I_C_I_Nm_C_I_Nm                ;  -1.0/2.0 * CC(t5,x5,-1,0,1)                 ;   gamma   ; 0 ; 1 ; 1
!---------------------------------------------------------------------------------------------------------------
! Spin-orbit NLO
! Time-even
! Term                         ! Coupling constant                                  ! DD_pow! isospin indices
E_D_I_I_Derm_C_I_NxmSxm        ; -wso /2.0 - wsoq/4.0                               ;   1   ; 0 ; 0
E_D_I_I_Derm_C_I_NxmSxm        ; -wsoq/4.0                                          ;   1   ; 1 ; 1
! Time-odd
! Term                         ! Coupling constant                                  ! DD_pow! isospin indices
E_C_I_Nm_Derxm_D_I_Sxm         ; -wso /2.0 - wsoq/4.0                               ;   1   ; 0 ; 0
E_C_I_Nm_Derxm_D_I_Sxm         ; -wsoq/4.0                                          ;   1   ; 1 ; 1
!---------------------------------------------------------------------------------------------------------------
! Pairing interaction 
! Time-even pairing density
! Term                         ! Coupling constant                                  ! DD_pow! isospin indices
E_DP_I_I_DP_I_I                ; +Vn/4                                              ;   1   ; n ; n   
E_DP_I_I_DP_I_I                ; +Vp/4                                              ;   1   ; p ; p   
E_D_I_I_DP_I_I_DP_I_I          ; -Vn/4*alpha/(0.16**sigmap)                         ; sigmap; 0 ; n ; n
E_D_I_I_DP_I_I_DP_I_I          ; -Vp/4*alpha/(0.16**sigmap)                         ; sigmap; 0 ; p ; p
E_Derm_D_I_I_Derm_D_I_I_DP_I_I_DP_I_I          ; kappa_n/4.0                        ;   1   ; 0 ; 0 ; n ; n ;  vmicro(D_I_I, INM_k2_pot(D_I_I), INM_k4_pot(D_I_I),1,ptype,interpolationtype,integrationtype)
E_Derm_D_I_I_Derm_D_I_I_DP_I_I_DP_I_I          ; kappa_p/4.0                        ;   1   ; 0 ; 0 ; p ; p ;  vmicro(D_I_I, INM_k2_pot(D_I_I), INM_k4_pot(D_I_I),2,ptype,interpolationtype,integrationtype)
E_DP_I_I_DP_I_I                ; +Vnm/4.0d0                                         ;   1   ; n ; n ;  vmicro(D_I_I, INM_k2_pot(D_I_I), INM_k4_pot(D_I_I),1,ptype,interpolationtype,integrationtype)
E_DP_I_I_DP_I_I                ; +Vpm/4.0d0                                         ;   1   ; p ; p ;  vmicro(D_I_I, INM_k2_pot(D_I_I), INM_k4_pot(D_I_I),2,ptype,interpolationtype,integrationtype)
! Time-odd pairing density
! Term                         ! Coupling constant                                  ! DD_pow! isospin indices
E_CP_I_I_CP_I_I                ; +Vn/4                                              ;   1   ; n ; n
E_CP_I_I_CP_I_I                ; +Vp/4                                              ;   1   ; p ; p
E_D_I_I_CP_I_I_CP_I_I          ; -Vn/4*alpha/(0.16**sigmap)                         ; sigmap; 0 ; n ; n
E_D_I_I_CP_I_I_CP_I_I          ; -Vp/4*alpha/(0.16**sigmap)                         ; sigmap; 0 ; p ; p
E_Derm_D_I_I_Derm_D_I_I_CP_I_I_CP_I_I          ; kappa_n/4.0                        ;   1   ; 0 ; 0 ; n ; n ;  vmicro(D_I_I, INM_k2_pot(D_I_I), INM_k4_pot(D_I_I),1,ptype,interpolationtype,integrationtype)
E_Derm_D_I_I_Derm_D_I_I_CP_I_I_CP_I_I          ; kappa_p/4.0                        ;   1   ; 0 ; 0 ; p ; p ;  vmicro(D_I_I, INM_k2_pot(D_I_I), INM_k4_pot(D_I_I),2,ptype,interpolationtype,integrationtype)
E_CP_I_I_CP_I_I                                ; +Vnm/4.0d0                         ;   1   ; n ; n ;  vmicro(D_I_I, INM_k2_pot(D_I_I), INM_k4_pot(D_I_I),1,ptype,interpolationtype,integrationtype)
E_CP_I_I_CP_I_I                                ; +Vpm/4.0d0                         ;   1   ; p ; p ;  vmicro(D_I_I, INM_k2_pot(D_I_I), INM_k4_pot(D_I_I),2,ptype,interpolationtype,integrationtype)
