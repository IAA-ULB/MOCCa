# (time-reversal invariant, local, central) N2LO functional 
# proposed by Ryssens & Bender. Jmunu^2 terms are optional
! (N) LO parameters
t0 ;  x0 ; t1 ;  x1 ; t2 ; x2 ; t3; x3 ; wso ; wsoq ; sigma ; CT0 ; CT1
! N2LO parameters
t1n2 ; x1n2 ; t2n2 ; x2n2
! Pairing strengths
Vn ; Vp ; alpha ; sigmap
!TERMS
!----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
! Time-even, central, LO terms
! Term                         ! Coupling constant                                  ! DD_pow! isospin indices
E_D_I_I_D_I_I                  ; Cc(t0,x0,+1,0,0)                                   ;   1   ; 0 ; 0
E_D_I_I_D_I_I                  ; Cc(t0,x0,+1,0,1)                                   ;   1   ; 1 ; 1
E_D_I_I_D_I_I_D_I_I            ; +1.0/6.0*Cc(t3,x3,+1,0,0)                          ; sigma ; 0 ; 0 ; 0
E_D_I_I_D_I_I_D_I_I            ; +1.0/6.0*Cc(t3,x3,+1,0,1)                          ; sigma ; 0 ; 1 ; 1
!----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
! Time-odd, central LO terms  
! Term                         ! Coupling constant                                  ! DD_pow! isospin indices
E_D_I_Sm_D_I_Sm                ; Cc(t0,x0,+1,1,0)                                   ;   1   ; 0 ; 0
E_D_I_Sm_D_I_Sm                ; Cc(t0,x0,+1,1,1)                                   ;   1   ; 1 ; 1
E_D_I_I_D_I_Sm_D_I_Sm          ; +1.0/6.0*Cc(t3,x3,+1,1,0)                          ; sigma ; 0 ; 0 ; 0
E_D_I_I_D_I_Sm_D_I_Sm          ; +1.0/6.0*Cc(t3,x3,+1,1,1)                          ; sigma ; 0 ; 1 ; 1
!----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
! Time-even, central NLO terms     
! Term                         ! Coupling constant                                  ! DD_pow! isospin indices
E_D_I_I_D_Nm_Nm                ; +1.0/2.0*Cc(t1,x1,+1,0,0)+1.0/2.0*Cc(t2,x2,-1,0,0) ;   1   ; 0 ; 0
E_D_I_I_D_Nm_Nm                ; +1.0/2.0*Cc(t1,x1,+1,0,1)+1.0/2.0*Cc(t2,x2,-1,0,1) ;   1   ; 1 ; 1
E_D_I_I_Lap_D_I_I              ; -3.0/8.0*Cc(t1,x1,+1,0,0)+1.0/8.0*Cc(t2,x2,-1,0,0) ;   1   ; 0 ; 0
E_D_I_I_Lap_D_I_I              ; -3.0/8.0*Cc(t1,x1,+1,0,1)+1.0/8.0*Cc(t2,x2,-1,0,1) ;   1   ; 1 ; 1
! Time-odd
! Term                         ! Coupling constant                                  ! DD_pow! isospin indices
E_C_I_Nm_C_I_Nm                ; -1.0/2.0*Cc(t1,x1,+1,0,0)-1.0/2.0*Cc(t2,x2,-1,0,0) ;   1   ; 0 ; 0
E_C_I_Nm_C_I_Nm                ; -1.0/2.0*Cc(t1,x1,+1,0,1)-1.0/2.0*Cc(t2,x2,-1,0,1) ;   1   ; 1 ; 1
E_D_I_Sm_Lap_D_I_Sm            ; -3.0/8.0*Cc(t1,x1,+1,1,0)+1.0/8.0*Cc(t2,x2,-1,1,0) ;   1   ; 0 ; 0
E_D_I_Sm_Lap_D_I_Sm            ; -3.0/8.0*Cc(t1,x1,+1,1,1)+1.0/8.0*Cc(t2,x2,-1,1,1) ;   1   ; 1 ; 1
!----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
! Time-even spin-orbit (NLO)
! Term                         ! Coupling constant                                  ! DD_pow! isospin indices
E_D_I_I_Derm_C_I_NxmSxm        ; -wso/2.0-wsoq/4.0                                  ;   1   ; 0 ; 0
E_D_I_I_Derm_C_I_NxmSxm        ; -wsoq/4.0                                          ;   1   ; 1 ; 1
! Time-odd spin-orbit (NLO)
! Term                         ! Coupling constant                                  ! DD_pow! isospin indices
E_C_I_Nm_Derxm_D_I_Sxm         ; -wso/2.0-wsoq/4.0                                  ;   1   ; 0 ; 0
E_C_I_Nm_Derxm_D_I_Sxm         ; -wsoq/4.0                                          ;   1   ; 1 ; 1
!----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
! SLy5-like JmnJmn term (NLO)
! Term                         ! Coupling constant                                  ! DD_pow! isospin indices
E_C_I_NmSk_C_I_NmSk            ; -CT0                                               ;   1   ; 0 ; 0
E_C_I_NmSk_C_I_NmSk            ; -CT1                                               ;   1   ; 1 ; 1
! Its time-odd companion
! Term                         ! Coupling constant                                  ! DD_pow! isospin indices
E_D_I_Sm_D_Nk_NkSm             ; +CT0                                               ;   1   ; 0 ; 0
E_D_I_Sm_D_Nk_NkSm             ; +CT1                                               ;   1   ; 1 ; 1
!----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
! Time-even, central N2LO terms
! Without spin
! - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
! These are the terms multiplying the following coupling constants in order
! Term                         ! Coupling constant                                            ! DD_pow! isospin indices
! A^(4,1)_e
E_Lap_D_I_I_Lap_D_I_I          ; +3.0/16.0*Cc(t1n2,x1n2,+1,0,0)-1.0/16.0*Cc(t2n2,x2n2,-1,0,0) ;   1   ; 0 ; 0
E_Lap_D_I_I_Lap_D_I_I          ; +3.0/16.0*Cc(t1n2,x1n2,+1,0,1)-1.0/16.0*Cc(t2n2,x2n2,-1,0,1) ;   1   ; 1 ; 1
! A^(4,2)_e
E_D_I_I_D_NmNm_NkNk            ; +1.0/4.0*Cc(t1n2,x1n2,+1,0,0)+1.0/4.0*Cc(t2n2,x2n2,-1,0,0) ;   1   ; 0 ; 0
E_D_I_I_D_NmNm_NkNk            ; +1.0/4.0*Cc(t1n2,x1n2,+1,0,1)+1.0/4.0*Cc(t2n2,x2n2,-1,0,1) ;   1   ; 1 ; 1
! A^(4,3)_e
E_D_Nm_Nm_D_Nk_Nk              ; +1.0/ 4.0*Cc(t1n2,x1n2,+1,0,0)+1.0/ 4.0*Cc(t2n2,x2n2,-1,0,0) ;   1   ; 0 ; 0
E_D_Nm_Nm_D_Nk_Nk              ; +1.0/ 4.0*Cc(t1n2,x1n2,+1,0,1)+1.0/ 4.0*Cc(t2n2,x2n2,-1,0,1) ;   1   ; 1 ; 1
! A^(4,4)_e
E_D_Nm_Nk_D_Nm_Nk              ; +2.0/ 4.0*Cc(t1n2,x1n2,+1,0,0)+2.0/ 4.0*Cc(t2n2,x2n2,-1,0,0) ;   1   ; 0 ; 0
E_D_Nm_Nk_D_Nm_Nk              ; +2.0/ 4.0*Cc(t1n2,x1n2,+1,0,1)+2.0/ 4.0*Cc(t2n2,x2n2,-1,0,1) ;   1   ; 1 ; 1
! A^(4,5)_e
E_D_Nm_Nk_Derm_Derk_D_I_I      ; -2.0/ 4.0*Cc(t1n2,x1n2,+1,0,0)-2.0/ 4.0*Cc(t2n2,x2n2,-1,0,0) ;   1   ; 0 ; 0
E_D_Nm_Nk_Derm_Derk_D_I_I      ; -2.0/ 4.0*Cc(t1n2,x1n2,+1,0,1)-2.0/ 4.0*Cc(t2n2,x2n2,-1,0,1) ;   1   ; 1 ; 1
! - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
! With spin
! Term                         ! Coupling constant                                            ! DD_pow! isospin indices
! A^(4,6)_e
E_C_I_NmSk_Lap_C_I_NmSk        ; -1.0/ 4.0*Cc(t1n2,x1n2,+1,1,0)-1.0/ 4.0*Cc(t2n2,x2n2,-1,1,0) ;   1   ; 0 ; 0
E_C_I_NmSk_Lap_C_I_NmSk        ; -1.0/ 4.0*Cc(t1n2,x1n2,+1,1,1)-1.0/ 4.0*Cc(t2n2,x2n2,-1,1,1) ;   1   ; 1 ; 1
! A^(4,7)_e. 
! Note, these terms should be zero for local functionals, but we program them for completeness' sake.
E_Derm_C_I_NmSk_Dero_C_I_NoSk  ; +1.0/ 2.0*Cc(t1n2,x1n2,+1,1,0)+1.0/ 2.0*Cc(t2n2,x2n2,-1,1,0) ;   1   ; 0 ; 0
E_Derm_C_I_NmSk_Dero_C_I_NoSk  ; +1.0/ 2.0*Cc(t1n2,x1n2,+1,1,1)+1.0/ 2.0*Cc(t2n2,x2n2,-1,1,1) ;   1   ; 1 ; 1
! A^(4,8)_e
E_C_I_NmSo_C_NkNk_NmSo         ; +1.0     *Cc(t1n2,x1n2,+1,1,0)+1.0     *Cc(t2n2,x2n2,-1,1,0) ;   1   ; 0 ; 0
E_C_I_NmSo_C_NkNk_NmSo         ; +1.0     *Cc(t1n2,x1n2,+1,1,1)+1.0     *Cc(t2n2,x2n2,-1,1,1) ;   1   ; 1 ; 1
!----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
! Time-odd, central N2LO terms
! With spin 
! - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
! These are the terms multiplying the following coupling constants in order
! Term                         ! Coupling constant                                            ! DD_pow! isospin indices
! A^(4,1)_o
E_Lap_D_I_Sm_Lap_D_I_Sm        ; +3.0/16.0*Cc(t1n2,x1n2,+1,1,0)-1.0/16.0*Cc(t2n2,x2n2,-1,1,0) ;   1   ; 0 ; 0
E_Lap_D_I_Sm_Lap_D_I_Sm        ; +3.0/16.0*Cc(t1n2,x1n2,+1,1,1)-1.0/16.0*Cc(t2n2,x2n2,-1,1,1) ;   1   ; 1 ; 1
! A^(4,2)_o
E_D_I_So_D_NkNk_NmNmSo         ; +1.0/ 4.0*Cc(t1n2,x1n2,+1,1,0)+1.0/ 4.0*Cc(t2n2,x2n2,-1,1,0) ;   1   ; 0 ; 0
E_D_I_So_D_NkNk_NmNmSo         ; +1.0/ 4.0*Cc(t1n2,x1n2,+1,1,1)+1.0/ 4.0*Cc(t2n2,x2n2,-1,1,1) ;   1   ; 1 ; 1
! A^(4,3)_o
E_D_Nk_NkSo_D_Nm_NmSo          ; +1.0/ 4.0*Cc(t1n2,x1n2,+1,1,0)+1.0/ 4.0*Cc(t2n2,x2n2,-1,1,0) ;   1   ; 0 ; 0
E_D_Nk_NkSo_D_Nm_NmSo          ; +1.0/ 4.0*Cc(t1n2,x1n2,+1,1,1)+1.0/ 4.0*Cc(t2n2,x2n2,-1,1,1) ;   1   ; 1 ; 1
! A^(4,4)_o
E_D_Nk_NmSo_D_Nk_NmSo          ; +2.0/ 4.0*Cc(t1n2,x1n2,+1,1,0)+2.0/ 4.0*Cc(t2n2,x2n2,-1,1,0) ;   1   ; 0 ; 0
E_D_Nk_NmSo_D_Nk_NmSo          ; +2.0/ 4.0*Cc(t1n2,x1n2,+1,1,1)+2.0/ 4.0*Cc(t2n2,x2n2,-1,1,1) ;   1   ; 1 ; 1
! A^(4,5)_o
E_D_Nm_NkSo_Derm_Derk_D_I_So   ; -2.0/ 4.0*Cc(t1n2,x1n2,+1,1,0)-2.0/ 4.0*Cc(t2n2,x2n2,-1,1,0) ;   1   ; 0 ; 0
E_D_Nm_NkSo_Derm_Derk_D_I_So   ; -2.0/ 4.0*Cc(t1n2,x1n2,+1,1,1)-2.0/ 4.0*Cc(t2n2,x2n2,-1,1,1) ;   1   ; 1 ; 1
! - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
! Without spin 
! Term                         ! Coupling constant                                            ! DD_pow! isospin indices
! A^(4,6)_o
E_C_I_Nk_Lap_C_I_Nk            ; -1.0/ 4.0*Cc(t1n2,x1n2,+1,0,0)-1.0/ 4.0*Cc(t2n2,x2n2,-1,0,0) ;   1   ; 0 ; 0
E_C_I_Nk_Lap_C_I_Nk            ; -1.0/ 4.0*Cc(t1n2,x1n2,+1,0,1)-1.0/ 4.0*Cc(t2n2,x2n2,-1,0,1) ;   1   ; 1 ; 1
! A^(4,7)_o
E_Derm_C_I_Nm_Derk_C_I_Nk      ; +1.0/ 2.0*Cc(t1n2,x1n2,+1,0,0)+1.0/ 2.0*Cc(t2n2,x2n2,-1,0,0) ;   1   ; 0 ; 0
E_Derm_C_I_Nm_Derk_C_I_Nk      ; +1.0/ 2.0*Cc(t1n2,x1n2,+1,0,1)+1.0/ 2.0*Cc(t2n2,x2n2,-1,0,1) ;   1   ; 1 ; 1
! A^(4,8)_o
E_C_I_Nm_C_NkNk_Nm             ; +1.0     *Cc(t1n2,x1n2,+1,0,0)+1.0     *Cc(t2n2,x2n2,-1,0,0) ;   1   ; 0 ; 0
E_C_I_Nm_C_NkNk_Nm             ; +1.0     *Cc(t1n2,x1n2,+1,0,1)+1.0     *Cc(t2n2,x2n2,-1,0,1) ;   1   ; 1 ; 1
!---------------------------------------------------------------------------------------------------------------
! Pairing interaction 
! Time-even pairing density
! Term                         ! Coupling constant                                  ! DD_pow! isospin indices
E_DP_I_I_DP_I_I                ; +Vn/4                                              ;   1   ; n ; n
E_DP_I_I_DP_I_I                ; +Vp/4                                              ;   1   ; p ; p
E_D_I_I_DP_I_I_DP_I_I          ; -Vn/4*alpha/(0.16**sigmap)                         ; sigmap; 0 ; n ; n
E_D_I_I_DP_I_I_DP_I_I          ; -Vp/4*alpha/(0.16**sigmap)                         ; sigmap; 0 ; p ; p
! Time-odd pairing density                  
! Term                         ! Coupling constant                                  ! DD_pow! isospin indices
E_CP_I_I_CP_I_I                ; +Vn/4                                              ;   1   ; n ; n
E_CP_I_I_CP_I_I                ; +Vp/4                                              ;   1   ; p ; p
E_D_I_I_CP_I_I_CP_I_I          ; -Vn/4*alpha/(0.16**sigmap)                         ; sigmap; 0 ; n ; n
E_D_I_I_CP_I_I_CP_I_I          ; -Vp/4*alpha/(0.16**sigmap)                         ; sigmap; 0 ; p ; p
