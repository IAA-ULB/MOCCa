# N3LO time-even functional
# includes density dependence 
!--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
! NLO terms
E_D_I_I_D_I_I             ;                        ;        ;                               ;      ; +3.0/8.0*t0+0*t0*x0+0*t3+0*t3*x3                                    ; -1.0/8.0*t0-0.25*t0*x0+0*t3+0*t3*x3 
E_D_I_I_D_I_I_DD          ; (sum(D_I_I,2)**(yt3a)) ;  D_I_I ; yt3a*(sum(D_I_I,2)**(yt3a-1)) ; yt3a ; 3.0_dp/48.0_dp * t3                                                 ; - 1.0_dp/24.0_dp * t3 * (0.5_dp + x3) 
E_D_I_I_D_Nm_Nm           ;                        ;        ;                               ;      ; +3.0/16.0*t1+0*t1*x1+5.0/16.0*t2+1/4.0*t2*x2                        ; -1.0/16.0*t1-1.0/8.0*t1*x1+1.0/16.0*t2+1.0/8.0*t2*x2 
E_D_I_I_Lap_D_I_I         ;                        ;        ;                               ;      ; -9.0/64.0*t1+0*t1*x1+5.0/64.0*t2+1/16.0*t2*x2                       ; +3.0/64.0*t1+3.0/32 *t1*x1+1.0/64.0*t2+1.0/32 *t2*x2 
!--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
! Time-even spin-orbit
!E_D_I_I_Derm_C_I_NxmSxm   ;                        ;        ;                               ;      ; -wso/2.0 - wsoq/4.0                                                 ; - wsoq/4.0
!--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
! SLy5-like JmnJmn term
!E_C_I_NmSk_C_I_NmSk       ;                        ;        ;                               ;      ;  -(1.0_dp/8.0_dp) * (t1*x1 + t2*x2) + (1.0_dp/16.0_dp) * (t1 - t2)  ; (1.0_dp/16.0_dp) * (t1 - t2)
!--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
! N2LO terms
E_Lap_D_I_I_Lap_D_I_I     ;                        ;        ;                               ;      ; +9/128.0*t1n2+0*t1n2 * x1n2-5/128.0*t2n2-4/128.0*t2n2 * x2n2 ; -3/128.0*t1n2-3/64.0*t1n2 * x1n2-1/128.0*t2n2-1/64.0*t2n2 * x2n2 
E_D_I_I_D_NmNm_NkNk       ;                        ;        ;                               ;      ; +3/32.0*t1n2+0*t1n2 * x1n2+5/32.0*t2n2+1/8.0*t2n2 * x2n2 ; -1/32.0*t1n2-1/16.0*t1n2 * x1n2+1/32.0*t2n2+1/16.0*t2n2 * x2n2 
E_D_Nm_Nm_D_Nk_Nk         ;                        ;        ;                               ;      ;+3/32.0*t1n2+0*t1n2 * x1n2+5/32.0*t2n2+1/8.0*t2n2 * x2n2 ; -1/32.0*t1n2-1/16.0*t1n2 * x1n2+1/32.0*t2n2+1/16.0*t2n2 * x2n2 
E_D_Nm_Nk_D_Nm_Nk         ;                        ;        ;                               ;       ;+6/32.0*t1n2+0*t1n2 * x1n2+10/32.0*t2n2+2/8.0*t2n2 * x2n2 ; -2/32.0*t1n2-2/16.0*t1n2 * x1n2+2/32.0*t2n2+2/16.0*t2n2 * x2n2 
E_D_Nm_Nk_Derm_Derk_D_I_I ;                        ;        ;                               ;      ;-6/32.0*t1n2+0*t1n2 * x1n2-10/32.0*t2n2-2/8.0*t2n2 * x2n2 ; +2/32.0*t1n2+2/16.0*t1n2 * x1n2-2/32.0*t2n2-2/16.0*t2n2 * x2n2 
E_C_Nm_NqSk_C_Nm_NqSk     ;                        ;        ;                               ;      ;+2/32.0*t1n2-2/16.0*t1n2*x1n2-2/32.0*t2n2-2/16.0*t2n2*x2n2; 2/32.0*t1n2+0*t1n2 * x1n2-2/32.0*t2n2+0*t2n2 * x2n2 
E_C_I_NmSq_C_Nk_NkNmSq    ;                        ;        ;                               ;      ;+4/32.0*t1n2-4/16.0*t1n2*x1n2-4/32.0*t2n2-4/16.0*t2n2*x2n2;+4/32.0*t1n2+0*t1n2 * x1n2-4/32.0*t2n2+0*t2n2 * x2n2 
!--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
! N3LO terms
E_D_I_I_Lap_Lap_Lap_D_I_I     ;                        ;        ;                               ;      ; 1/256.0 * (-27 * t1n3 + t2n3 * (5 + 4 * x2n3)) ; 1/256.0 * (t2n3 * ( 1 + 2 * x2n3) + 9 * t1n3 * (1 + 2 * x1n3)) 
E_D_Nm_Nm_Lap_Lap_D_I_I       ;                        ;        ;                               ;      ;  3/32.0 * (3 * t1n3 + t2n3 * (5 + 4 * x2n3))    ; 3/32.0 * ( t2n3 * (1 + 2*x2n3) - t1n3 * (1 + 2 * x1n3))
E_D_Nm_Nm_Lap_D_Nq_Nq         ;                        ;        ;                               ;      ; -3/32.0 * (3 * t1n3 + t2n3 * (5 + 4 * x2n3))    ; -3/32.0 * ( t2n3 * (1 + 2*x2n3) - t1n3 * (1 + 2 * x1n3))
E_Lap_D_I_I_Derm_Derq_D_Nm_Nq ;                        ;        ;                               ;      ;  3/32.0 * (3 * t1n3 + t2n3 * (5 + 4 * x2n3))    ;  3/32.0 * ( t2n3 * (1 + 2*x2n3) - t1n3 * (1 + 2 * x1n3))
E_D_Nk_Nk_Derm_Derq_D_Nm_Nq   ;                        ;        ;                               ;      ; -3/16.0 * (3 * t1n3 + t2n3 * (5 + 4 * x2n3))    ; -3/16.0 * ( t2n3 * (1 + 2*x2n3) - t1n3 * (1 + 2 * x1n3))
E_D_Nm_Nq_Lap_D_Nm_Nq         ;                        ;        ;                               ;      ; -3/16.0 * (3 * t1n3 + t2n3 * (5 + 4 * x2n3))    ; -3/16.0 * ( t2n3 * (1 + 2*x2n3) - t1n3 * (1 + 2 * x1n3))
E_D_NmNk_NmNk_Lap_D_I_I       ;                        ;        ;                               ;      ; -3/32.0 * (3 * t1n3 + t2n3 * (5 + 4 * x2n3))    ; -3/32.0 * ( t2n3 * (1 + 2*x2n3) - t1n3 * (1 + 2 * x1n3))
E_D_NmNk_NmNq_D_Nk_Nq         ;                        ;        ;                               ;      ; 12/16.0 * (3 * t1n3 + t2n3 * (5 + 4 * x2n3))    ; 12/16.0 * ( t2n3 * (1 + 2*x2n3) - t1n3 * (1 + 2 * x1n3))
E_D_I_I_D_NmNkNq_NmNkNq       ;                        ;        ;                               ;      ;  1/16.0 * (3 * t1n3 + t2n3 * (5 + 4 * x2n3))    ;  1/16.0 * ( t2n3 * (1 + 2*x2n3) - t1n3 * (1 + 2 * x1n3))
E_D_Nm_Nm_D_NqNk_NqNk         ;                        ;        ;                               ;      ;  3/16.0 * (3 * t1n3 + t2n3 * (5 + 4 * x2n3))    ;  3/16.0 * ( t2n3 * (1 + 2*x2n3) - t1n3 * (1 + 2 * x1n3))
E_D_I_I_Derq_Derk_D_NmNq_NmNk ;                        ;        ;                               ;      ;  3/16.0 * (3 * t1n3 + t2n3 * (5 + 4 * x2n3))    ;  3/16.0 * ( t2n3 * (1 + 2*x2n3) - t1n3 * (1 + 2 * x1n3))
