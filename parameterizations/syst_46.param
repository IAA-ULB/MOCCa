!-------------------------------------------------------------------------------
! Syst_45 parameterization, a candidate for BSkG3 
! as sent to me (=W. R.) by G. Grams 22/08/'22 
!-------------------------------------------------------------------------------
&skf 
name= 'syst_46' 
func_file= 'BXL.func' 
!- - - - - - - - - - - - - - - - - - - -
! Skyrme parameters
t0       = -2318.064989795077, 
t1       =   732.0235151911147, 
t2       =     0.010135, 
t3       = 13984.755198640958, 
t4       =  -470.566, 
t5       =  -112.78004583359554,  
x0       =     0.609139, 
x1       =     2.56632, 
x2       =-41208.247263003024, 
x3       =     0.6912656635350953, 
x4       =     4.66652, 
x5       =    -4.9531053036687736, 
sigma    =     0.2,  
beta     =     0.08333, 
gamma    =     0.25, 
wso      =   118.565, 
wsoq     =    79.3256,  
CSDS0    =     0.0,                ! No s \Delta s term 
CSDS1    =     0.0,                !  
CT0      =     0.0,                ! Jmunu terms 
CT1      =     0.0,                !  
hbm(1)   =    20.73553000,  20.73553000,    
!- - - - - - - - - - - - - - - - - - - -
! Pairing parameters
Vn         =     0.0, 
Vp         =     0.0, 
Vnm        =     1.00, 
Vpm        =     1.00, 
kappa_n    =   120.77, 
kappa_p    =   159.97, 
alpha      =     1.00, 
sigmap     =     1.00, 
Estabn     =     0.00, 
Estabp     =     0.00, 
Cuttype    = 2  
Cutneutron = 7.337  
Cutproton  = 7.337  
!- - - - - - - - - - - - - - - - - - - 
!  Treatment of coulomb interaction
e2            = 1.43996446, 
Protonsize    = 0.895, 0.0 
Neutronsize   = 0.387, 0.467  
nucleonsize_selfconsistent=.true. 
CoulTreatment = 2 
HOcomform     = .false. 
! - - - - - - - - - - - - - - - - - -
! Collective correction
COM1Body = 2 
COM2Body = 1 
rotcorr  = 1  
rotcorrb    = 0.951926  
rotcorrc    = 9.27582  
vibcorrd    = 0.382874  
vibcorrl    = 4.05859  
vibcorrb    = 0.83282   
eps = 1d-8 
 	/
