!-------------------------------------------------------------------------------
! SkM* parameterization
!     J. Bartel, P. Quentin, M. Brack, C. Guet and H.-B. Hakansson
!     Nuclear Physics A386, 79-100 (1982). 
! which was obtained as a slight variation on SkM of
!     H. Krivine, J. Treiner and P. Bohigas
!     Nuclear Physics A336, 155-184 (1980)
!-------------------------------------------------------------------------------

&skf
name      = "SkMs"
func_file = "NLO.func" 
t0        = -2645.0000
t1        = 410.0000
t2        = -135.0000
t3        = 15595.0000
x0        =     0.0900
x1        =     0.0000
x2        =     0.0000
x3        =     0.0000
sigma     =     0.166666666666666666667 
x3b       =     0.0
t3b       =     0.0
sigma_b   =     0.0
wso       =   130.0000
wsoq      =   130.0000
Vp        =  -1250.00000       ! Standard "ULB" pairing
Vn        =  -1250.00000       ! -> this is not perfectly justified since the effective mass here is 0.79 instead of 0.7
alpha    =    1.0             
sigmap   =    1.0
COM1Body = 2
CSDS0    = 0.0                             ! No s \Delta s term
CSDS1    = 0.0                             ! 
CT0      = 0.0                             ! No Jmunu terms
CT1      = 0.0                             ! 
hbm(1)=20.73551944943154,20.73551944943154 
/
