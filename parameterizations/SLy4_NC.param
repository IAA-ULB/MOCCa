!-------------------------------------------------------------------------------
! SLy4 parameterization
!
! E. Chabanat et al. Nucl. Phys. A 635, 231 (1998).
! E. Chabanat et al. Nucl. Phys. A 643, 441 (1998).
!-------------------------------------------------------------------------------
&skf 
name     = "SLy4_NC" 
func_file= 'NLO.func'
t0       =  -2488.913,
t1       =    486.818,
t2       =   -546.395,
t3       =  13777.0, 
x0       =      0.834,
x1       =     -0.344,
x2       =     -1.0,
x3       =      1.354,
sigma    =      0.166666666666666666667 
x3b      =      0.0
t3b      =      0.0
sigma_b  =      10.0
wso      =    123.0,
wsoq     =    123.0 
Vp       =  -1250.00000
Vn       =  -1250.00000
alpha    =    1.0
sigmap   =    1.0
hbm(1)   = 20.73551910, 20.73551910        
COM1Body = 2
CSDS0    = 0.0                             ! No s \Delta s term
CSDS1    = 0.0                             ! 
CT0      = 0.0                             ! No Jmunu terms
CT1      = 0.0                             ! 
CoulTreatment = 0 						   ! disable coulomb
/


