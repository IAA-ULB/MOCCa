!-------------------------------------------------------------------------------
! SLy6 parameterization
!
! E. Chabanat et al. Nucl. Phys. A 635, 231 (1998).
! E. Chabanat et al. Nucl. Phys. A 643, 441 (1998).
!-------------------------------------------------------------------------------
&skf 
name     = "SLy6" 
func_file= 'NLO.func'
t0       =  -2479.50,
t1       =    462.18,
t2       =   -448.61,
t3       =  13673.0, 
x0       =      0.825,
x1       =     -0.465,
x2       =     -1.0,
x3       =       1.355,
sigma    =      0.166666666666666666667 
wso      =    122.0,
wsoq     =    122.0 
Vn       =  -1250.00000
Vp       =  -1250.00000
alpha    =    1.0
sigmap   =    1.0
hbm(1)   = 20.7361986,20.7361986
COM1Body = 2
COM2Body = 1
CSDS0    = 0.0                             ! No s \Delta s term
CSDS1    = 0.0                             ! 
CT0      = 0.0                             ! No Jmunu terms
CT1      = 0.0                             ! 
/

