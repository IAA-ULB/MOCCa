!-------------------------------------------------------------------------------
! BSk29 parameterization
! S. Goriely, Nuclear Physics A 933, 68 (2015).
! Note: Tantalus cannot simulate the pairing of this parameterization, and in 
!       particular the concept of kappa_p and kappa_n is absolutely not the 
!       same as in the paper.
!-------------------------------------------------------------------------------
&skf 
name     = "BSk29" 
func_file= 'BXL.func'
! - - - - - - - - - - - - - - - - - - - - - 
! Particle-hole parameters 
t0       =   -3970.40,
t1       =     394.880,
t2       =       0.0001,
t3       =   22649.3,
t4       =    -100.0,
t5       =    -150.0, 
x0       =       0.964850,
x1       =      -0.00477741,
x2       =   -13889500.0,
x3       =       1.14453,
x4       =       2.0,
x5       =     -11.0,
sigma    =      0.0833333333, 
beta     =      0.5,
gamma    =      0.0833333333,
wso      =    64.6,
wsoq     =   193.8
CSDS0    = 0.0                             ! No s \Delta s term
CSDS1    = 0.0                             ! 
CT0      = 0.0                             ! No Jmunu terms
CT1      = 0.0                             ! 
! - - - - - - - - - - - - - - - - - - - - - 
! Pairing parameters 
Vp       =  0.00000
Vn       =  0.00000
Vnm      =  1.0
Vpm      =  1.0
kappa_n  =  0.0
kappa_p  =  0.0
alpha    =  1.0
sigmap   =  1.0
Cutneutron =  16
Cutproton  =  16
cuttype    =  2
! - - - - - - - - - - - - - - - - - - - - - 
! Constants and Coulomb
hbm(1)   = 20.72126890,20.74983164      
COM1Body = 2
COM2Body = 1
Protonsize    = 0.895, 0.0
Neutronsize   = 0.387, 0.467 
HOcomform     = .true.
nucleonsize_selfconsistent=.false.
CoulTreatment = 2
eps      = 1e-8
ptype=0
intertype=1
/


