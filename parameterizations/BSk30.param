!-------------------------------------------------------------------------------
! BSk30 parameterization
! S. Goriely, N. Chamel and J. M. Pearson, Phys. Rev. C 93, 034337 (2016).
!
! Note: Tantalus cannot simulate the pairing of this parameterization, and in 
!       particular the concept of kappa_p and kappa_n is absolutely not the 
!       same as in the paper.
!-------------------------------------------------------------------------------
&skf 
name     = "BSk30" 
func_file= 'BXL.func'
! - - - - - - - - - - - - - - - - - - - - - 
! Particle-hole parameters 
t0       =   -2299.92,
t1       =     760.62,
t2       =       0.0001,
t3       =   13782.7,
t4       =    -500.0,
t5       =     -40.0, 
x0       =       0.821058,
x1       =       2.675188,
x2       =-4205100.0,
x3       =       1.06250,
x4       =       5.0,
x5       =     -12.0,
sigma    =       0.2, 
beta     =       0.083333333,
gamma    =       0.25,
wso      =      62.466,
wsoq     =     187.398 
CSDS0    = 0.0                             ! No s \Delta s term
CSDS1    = 0.0                             ! 
CT0      = 0.0                             ! No Jmunu terms
CT1      = 0.0                             ! 
! - - - - - - - - - - - - - - - - - - - - - 
! Pairing parameters 
Vp         =  0.00000
Vn         =  0.00000
Vnm        =  1.0
Vpm        =  1.0 
kappa_n    = -37425.8
kappa_p    = -41876.7
pairingmu  =  0.25,0.25
Cutneutron =  6.5
Cutproton  =  6.5
cuttype    =  2
alpha      =  1.0
sigmap     =  1.0
! - - - - - - - - - - - - - - - - - - - - - 
! Constants and Coulomb
hbm(1)   = 20.72126890,20.74983164      
e2       = 1.43996446
COM1Body = 2
COM2Body = 1
Protonsize    = 0.895, 0.0
Neutronsize   = 0.387, 0.467 
HOcomform     = .true.
nucleonsize_selfconsistent=.false.
CoulTreatment = 2
eps=1e-8
ptype=0
interpolationtype=0
integrationtype=0

/


