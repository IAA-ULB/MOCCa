! W. Ryssens and M. Bender, in preparation. 
! 
! Note that this parameterisation was fitted to doubly-magic nuclei only, 
! and pairing was not included. This file uses a standard ULB pairing with 
! the strength typically used for SLy4.
!-------------------------------------------------------------------------------
&skf 
name     = "SN2LO1-Becker" 
func_file= 'N2LO.Becker.func'
t0       =  -2486.90786,
t1       =    497.51821,
t2       =   -451.60715,
t3       =  13707.18320, 
t1n2     =    -11.95063,
t2n2     =    -15.04405,
x0       =      0.57160369,
x1       =     -0.05521333,
x2       =     -0.99803779,
x3       =      0.88704830,
x1n2     =      0.10279808,
x2n2     =     -0.93024200,
sigma    =      0.166666666666666666667 
wso      =    117.904418,
wsoq     =    117.904418, 
CT0      =     -6.413914397
CT1      =    -59.320335000
Vn       =  -1250.00000
Vp       =  -1250.00000
alpha    =    1.0
sigmap   =    1.0
hbm(1)   = 20.73553,20.73553
COM1Body = 2
/ 
!-------------------------------------------------------------------------------
! SN2LO1 parameterization of the N2LO functional using the parameter values
! of 
!
! P. Becker, D. Davesne, J. Meyer, J. Navarro and A. Pastore,
! Phys. Rev. C 96, 044330 (2017).
!
! The functional form is however the more optimal one shown in 
! 
! W. Ryssens and M. Bender, in preparation. 
! 
! Note that this parameterisation was fitted to doubly-magic nuclei only, 
! and pairing was not included. This file uses a standard ULB pairing with 
! the strength typically used for SLy4.
!-------------------------------------------------------------------------------
&skf 
name     = "SN2LO1" 
func_file= 'N2LO.func'
t0       =  -2486.90786,
t1       =    497.51821,
t2       =   -451.60715,
t3       =  13707.18320, 
t1n2     =    -11.95063,
t2n2     =    -15.04405,
x0       =      0.57160369,
x1       =     -0.05521333,
x2       =     -0.99803779,
x3       =      0.88704830,
x1n2     =      0.10279808,
x2n2     =     -0.93024200,
sigma    =      0.166666666666666666667 
wso      =    117.904418,
wsoq     =    117.904418, 
CT0      =     -6.413914397
CT1      =    -59.320335000
Vn       =  -1250.00000
Vp       =  -1250.00000
alpha    =    1.0
sigmap   =    1.0
hbm(1)   = 20.73553,20.73553
COM1Body = 2
/ 
!-------------------------------------------------------------------------------
! SV-bas parameterization from P. Kl\"upfel et al, PRC 79, 034310 (2009).
!-------------------------------------------------------------------------------
&skf 
NAME     = 'SV-bas' 
func_file= 'NLO.func'
t0       = -1879.639
x0       =     0.258546
t1       =   313.749
x1       =    -0.381689
t2       =   112.677
x2       =    -2.823638
t3       = 12527.376
x3       =     0.123229
sigma    =     0.3
wso      = 124.634
wsoq     =  68.22334 
Vn       = -674.618
Vp       = -606.902
! What is called the switching density  \rho_pair in the paper can be simulated
! in our case through the appropriate use of our scaling factor alpha. 
!    We have alpha = 0.16/\rho_pair.
alpha    =     0.795505394521
sigmap   =     1.0
hbm(1)   = 20.721260, 20.749821
COM1Body = 1
COM2Body = 1
CSDS0    = 0.0                             ! No s \Delta s term
CSDS1    = 0.0                             ! 
CT0      = 0.0                             ! No Jmunu terms
CT1      = 0.0                             ! 
/

!-------------------------------------------------------------------------------
! SVI parameterization
! From
!   M. Beiner et al.
!   Nuclear ground-state properties and self-consistent calculations with the
!   Skyrme interaction
!   Nuclear Physics A238 29 - 69 (1975).
!-------------------------------------------------------------------------------
&skf 
name     = "SVI" 
func_file= 'NLO.func'
t0       =  -1101.81,
t1       =    271.67,
t2       =   -138.33,
t3       =  17000.0, 
x0       =      0.583,
x1       =      0,
x2       =      0,
x3       =      1,
sigma    =      1
wso      =    115.0,
wsoq     =    115.0 
Vp       =  -1250.00000
Vn       =  -1250.00000
alpha    =    1.0
sigmap   =    1.0
hbm(1)   = 20.73551910, 20.73551910 
COM1Body = 2
CSDS0    = 0.0                             ! No s \Delta s term
CSDS1    = 0.0                             ! 
CT0      = 0.0                             ! No Jmunu terms
CT1      = 0.0                             ! 
/
!-------------------------------------------------------------------------------
! SV-mas07 parameterization from P. Kl\"upfel et al, PRC 79, 034310 (2009).
!-------------------------------------------------------------------------------
&skf 
name     = "SV-mas07" 
func_file= 'NLO.func'
t0       = -2203.658
x0       =     0.354369
t1       =   438.349
x1       =    -1.78294
t2       =   566.845
x2       =    -1.436932
t3       = 12222.736
x3       =     0.632534
sigma    =     0.2
wsoq     =   115.53698
wso      =   113.522
hbm(1)   =    20.721260, 20.749821  
Vn       =  -688.246
Vp       =  -752.655
! What is called the switching density  \rho_pair in the paper can be simulated
! in our case through the appropriate use of our scaling factor alpha. 
!    We have alpha = 0.16/\rho_pair.
alpha    =     0.795149587516
sigmap   =     1.0
hbm(1)   = 20.721260, 20.749821
COM1Body = 1
COM2Body = 1
CSDS0    = 0.0                             ! No s \Delta s term
CSDS1    = 0.0                             ! 
CT0      = 0.0                             ! No Jmunu terms
CT1      = 0.0                             ! 
/
