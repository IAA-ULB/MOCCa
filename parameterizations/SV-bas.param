!-------------------------------------------------------------------------------
! SV-bas parameterization from P. Kl\"upfel et al, PRC 79, 034310 (2009).
!-------------------------------------------------------------------------------
&skf 
NAME     = 'SV-bas' 
func_file= 'NLO.func'
t0       = -1879.639
x0       =     0.258546
t1       =   313.749
x1       =    -0.381689
t2       =   112.677
x2       =    -2.823638
t3       = 12527.376
x3       =     0.123229
sigma    =     0.3
wso      = 124.634
wsoq     =  68.22334 
Vn       = -674.618
Vp       = -606.902
! What is called the switching density  \rho_pair in the paper can be simulated
! in our case through the appropriate use of our scaling factor alpha. 
!    We have alpha = 0.16/\rho_pair.
alpha    =     0.795505394521
sigmap   =     1.0
hbm(1)   = 20.721260, 20.749821
COM1Body = 1
COM2Body = 1
CSDS0    = 0.0                             ! No s \Delta s term
CSDS1    = 0.0                             ! 
CT0      = 0.0                             ! No Jmunu terms
CT1      = 0.0                             ! 
/

