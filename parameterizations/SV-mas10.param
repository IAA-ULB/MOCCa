!-------------------------------------------------------------------------------
! SV-mas10 parameterization from P. Kl\"upfel et al, PRC 79, 034310 (2009).
!-------------------------------------------------------------------------------
&skf 
name     = "SV-mas10" 
func_file= 'NLO.func'
t0       = -1813.907
x0       =     0.232898
t1       =   270.452
x1       =     0.127181
t2       =    57.215
x2       =    -4.795203
t3       = 12965.454
x3       =    -0.062346
x3b      =      0.0
t3b      =      0.0
sigma_b  =      0.0
sigma    =     0.33
wsoq     =    54.27844
wso      =   127.649
hbm(1)   =    20.721260, 20.749821  
CT0      =     0.0
CT1      =     0.0
Vp       =  -665.102
Vn       =  -558.101
! What is called the switching density  \rho_pair in the paper can be simulated
! in our case through the appropriate use of our scaling factor alpha. 
!    We have alpha = 0.16/\rho_pair.
alpha    =     0.80914331951
sigmap   =     1.0
hbm(1)   = 20.721260, 20.749821
COM1Body = 1
COM2Body = 1
CSDS0    = 0.0                             ! No s \Delta s term
CSDS1    = 0.0                             ! 
CT0      = 0.0                             ! No Jmunu terms
CT1      = 0.0                             ! 
/
