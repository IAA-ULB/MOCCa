!-------------------------------------------------------------------------------
! BSk26 parameterization
! S. Goriely, N. Chamel, and J. M. Pearson, Phys. Rev. C 88, 024308 (2013).
! Note: Tantalus cannot simulate the pairing of this parameterization, and in 
!       particular the concept of kappa_p and kappa_n is absolutely not the 
!       same as in the paper.
!-------------------------------------------------------------------------------
&skf 
name     = "BSk26" 
func_file= 'BXL.func'
! - - - - - - - - - - - - - - - - - - - - - 
! Particle-hole parameters 
t0       =   -4072.53,
t1       =     439.536,
t2       =       0.0001,
t3       =   23369.1,
t4       =    -100.0,
t5       =    -120.0, 
x0       =       0.577367,
x1       =      -0.404961,
x2       =   -11477000.0,
x3       =       0.624831,
x4       =      -3.0,
x5       =     -11.0,
sigma    =      0.0833333333, 
beta     =      0.1666666667,
gamma    =      0.0833333333,
wso      =    110.509,
wsoq     =    110.509,
CSDS0    = 0.0                             ! No s \Delta s term
CSDS1    = 0.0                             ! 
CT0      = 0.0                             ! No Jmunu terms
CT1      = 0.0                             ! 
! - - - - - - - - - - - - - - - - - - - - - 
! Pairing parameters 
Vp       =  0.00000
Vn       =  0.00000
Vnm      =  1.0
Vpm      =  1.0
kappa_n  =  0.0
kappa_p  =  0.0
alpha    =  1.0
sigmap   =  1.0
Cutneutron =  16
Cutproton  =  16
cuttype    =  2
! - - - - - - - - - - - - - - - - - - - - - 
! Constants and Coulomb
hbm(1)   = 20.72126890,20.74983164      
COM1Body = 2
COM2Body = 1
Protonsize    = 0.895, 0.0
Neutronsize   = 0.387, 0.467 
HOcomform     = .true.
nucleonsize_selfconsistent=.false.
CoulTreatment = 2
eps      = 1e-8
ptype=0
interpolationtype=1
integrationtype=0

/


