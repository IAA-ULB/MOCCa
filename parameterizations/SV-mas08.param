!-------------------------------------------------------------------------------
! SV-mas08 parameterization from P. Kl\"upfel et al, PRC 79, 034310 (2009).
!-------------------------------------------------------------------------------
&skf 
name     = "SV-mas08" 
func_file= 'NLO.func'
t0       = -1982.650
x0       =     0.285653
t1       =   368.228
x1       =    -1.037404
t2       =   274.611
x2       =    -1.780825
t3       = 12141.094
x3       =     0.339364
x3b      =      0.0
t3b      =      0.0
sigma_b  =      0.0
sigma    =     0.26
wsoq     =    88.67138
wso      =   119.794
Vp       =  -678.404
Vn       =  -621.138
! What is called the switching density  \rho_pair in the paper can be simulated
! in our case through the appropriate use of our scaling factor alpha. 
!    We have alpha = 0.16/\rho_pair.
alpha    =     0.769934074395
sigmap   =     1.0
hbm(1)   = 20.721260, 20.749821
COM1Body = 1
COM2Body = 1
CSDS0    = 0.0                             ! No s \Delta s term
CSDS1    = 0.0                             ! 
CT0      = 0.0                             ! No Jmunu terms
CT1      = 0.0                             ! 
/
