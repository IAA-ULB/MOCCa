x2       =   -4264900,
x3       =      0.61796,
x4       =      5.00000000,
x5       =    -12.00000000,
beta     =      0.08333333,
gamma    =      0.25000000,
sigma    =      0.20000000,
wso      =    63.700000000,
wsoq     =   127.400000000,
CT0      =      0.00000000,
CT1      =      0.00000000,
CSDS0    =      0.00000000,
CSDS1    =      0.00000000,
Vn       =      0.00000000,
Vp       =      0.00000000,
Vng      =      0.00000000,
Vpg      =      0.00000000,
alpha    =      0.69203290,
sigmap   =      0.77348339,
Estabn   =      0.00000000,
