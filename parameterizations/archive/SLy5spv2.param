!-------------------------------------------------------------------------------
! SLy5spv2 parameterization by K. Bennaceur, based on the SKP form.
!
!-------------------------------------------------------------------------------
&skf 
name     = "SLy5spv2.switch" 
func_file= 'DD-switch.func'
t0       =     -1733.931  ,
t1       =      343.055   ,
t2       =     -683.538   ,
t3       =      11497.971 ,
x0       =      0.548796  ,
x1       =     -0.026544  ,
x2       =     -0.996846  ,
x3       =      1.0,
sigma    =      0.33333333,
wso      =    103.337,
hbm(1)   = 20.73553, 20.73553 
COM1Body = 2
force_switch =  1.0,
! The following should not be used, but the code insists reading it
Vn       = 0.0
Vp       = 0.0
alpha    = 0.0
sigmap   = 0.0
CT0 = 0.0
CT1 = 0.0
wsoq=0.0
/

