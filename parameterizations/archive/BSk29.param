!-------------------------------------------------------------------------------
! BSk29 generalized Skyrme parameterization
!
!    S. Goriely, Nucl. Phys. A 933, 68 (2015).
! Note: 
! * No pairing defined yet
! * the spin-orbit part should perhaps be double-checked
! * the independent parameters (t2,t2x2) are not treated that way
!-------------------------------------------------------------------------------
&skf
name     =  'BSk29'
func_file=  'DD-switch.func'
force_switch = 0.0
t0       =  -3970.40
t1       =    394.880,
t2       =     0.0001,
t3       =  22649.30000000,
t4       =  -100.000000000,
t5       =  -150.00000000, 
x0       =      0.964850,
x1       =     -0.0047741,
x2       = -13889500.0,
x3       =      1.14453,
x4       =      2.0,
x5       =    -11.0,
beta     =      0.5,
gamma    =      0.08333333,
sigma    =      0.08333333,
wso      =    64.600000000,
wsoq     =   64.600000000,
CT0      =      0.00000000,
CT1      =      0.00000000,
CSDS0    =      0.00000000,
CSDS1    =      0.00000000,
Vn       =  0.0 ,
Vp       =  0.0,
Vng      =  0.0
Vpg      =  0.0 !-44933.1000000,
alpha    =      0.69203290,
sigmap   =      0.77348339,
Estabn   =      0.00000000,
Estabp   =      0.00000000,
cutproton  = 7.42,
cutneutron = 7.42,
hbm(1)   =     20.73553000,     20.73553000,
COM1Body = 2
COM2Body = 1
e2            = 1.439964460
Protonsize    = 0.895, 0.00
Neutronsize   = 0.387, 0.467
HOcomform     = .true.
nucleonsize_selfconsistent=.true.
CoulTreatment = 2
rotcorr  = 0
rotcorrb = 0.93
rotcorrc = 5.00
eps      = 1e-14
/
