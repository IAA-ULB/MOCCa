!-------------------------------------------------------------------------------
! VLyB32 parameterization
! 
! D. Davesne et al., 
! Extended Skyrme pseudopotential deduced from infinite nuclear matter properties
! PRC 91, 064303 (2015).
!
! Note that this is the implementation WITHOUT tensor terms, neither the NLO, 
! or the N2LO tensor terms are included. In addition, the J^2 terms are not
! included.
!-------------------------------------------------------------------------------
&skf 
name     = 'VLYB32' 
func_file= 'N2LO.func'
t0       =  -1491.46,
t1       =    133.037,
t2       =    513.2670,
t3       =   8000.00, 
t1n2     =    -14.6617,
t2n2     =    -65.3664,
x0       =      0.409966,
x1       =     -3.97968,
x2       =     -1.01914,
x3       =      1.000000,
x1n2     =     -0.745637,
x2n2     =     -1.22006,
sigma    =      0.3333333333333333333, 
wso      =    245.741,
wsoq     =    245.741, 
CT0      =      0.0
CT1      =      0.0
hbm(1)   = 20.73553,20.73553
COM1Body = 2
/ 
