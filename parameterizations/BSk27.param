!-------------------------------------------------------------------------------
! BSK27 parameterization
! From: 
! S. Goriely, N. Chamel and J. M. Pearson, Phys. Rev. C  88, 061302(R) (2013).
!
! Note: the pairing parameters are not included!
!-------------------------------------------------------------------------------
&skf 
name     = "BSK27" 
func_file= 'BXL.func'
t0  = -0.1837060863E+04 , x0 = 0.4600673712E+00
t1  =  0.3761855572E+03 , x1 =-0.3858531133E+00
t2  = -0.6030802735E+02 , x2 = 0.1259817673E+01
t3  = 0.1152167193E+05 , x3 = 0.6403012547E+00
wso = 0.1146308139E+03 , wsoq=0.1146308139E+03
t4  = 0.0
t5  = 0.0
x4  = 0.0
x5  = 0.0
beta= 0.0
gamma= 0.0
CSDS0= 0.0
CSDS1= 0.0
sigma    =      0.3 
CT0      =      0.0
CT1      =      0.0
! - - - - - - - - - - - - - - - - - - - - - 
! Pairing parameters 
Vn        =  -456.60000
Vp        =  -500.20000
Cutneutron=  16.0
Cutproton =  16.0
cuttype   =  2
alpha     =    0.45
sigmap    =    0.47
pairingmu =  0.25,0.25
kappa_n   =  0.0
kappa_p   =  0.0
Vnm       =  0.0
Vpm       =  0.0
! - - - - - - - - - - - - - - - - - - - - - 
hbm(1)      = 20.72126890,20.74983164
COM1Body = 2
COM2Body = 1
e2            = 1.43996446
Protonsize    = 0.895, 0.0
Neutronsize   = 0.387, 0.467 
HOcomform     = .true.
nucleonsize_selfconsistent=.false.
CoulTreatment = 2
/
