!-------------------------------------------------------------------------------
! SLy5 parameterization
!
! E. Chabanat et al. Nucl. Phys. A 635, 231 (1998).
! E. Chabanat et al. Nucl. Phys. A 643, 441 (1998).
!-------------------------------------------------------------------------------
&skf 
name     = "SLy5" 
func_file= 'NLO.func'
t0       = -2484.880,
t1       =   483.130,
t2       =  -549.400, 
t3       = 13763.0, 
x0       =     0.778,
x1       =    -0.328,
x2       =    -1.0,
x3       =     1.267 
sigma    =     0.1666666666666666666667
sigma_b  =     0.0
x3b      =     0.0
t3b      =     0.0
wso      =   126.0, 
wsoq     =   126.0 
CSDS0    =     0.0                           ! No s \Delta s term for stability
CSDS1    =     0.0                           ! 
CT0      =   -15.666455 
CT1      =   -64.533125  
Vn       = -1250.00000
Vp       = -1250.00000
alpha    =     1.0
sigmap   =     1.0
hbm(1)   = 20.73553,20.73553
COM1Body = 2
/
