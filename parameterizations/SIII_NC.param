!-------------------------------------------------------------------------------
! SIII parameterization
!
!-------------------------------------------------------------------------------
&skf 
name     = "SIII_NC"
func_file= 'NLO.func'
t0       =  -1128.750000,
t1       =    395.000000,
t2       =    -95.000000,
t3       =  14000.0,
x0       =      0.45,
x1       =      0.0,
x2       =      0.0,
x3       =      1.0,
sigma    =      1.00000
x3b      =      0.0
t3b      =      0.0
sigma_b  =      0.0
wso      =    120.0,
wsoq     =    120.0
Vp       =  -1250.00000
Vn       =  -1250.00000
alpha    =    1.0
sigmap   =    1.0
hbm(1)   = 20.73551910, 20.73551910        
COM1Body = 2
CSDS0    = 0.0                             ! No s \Delta s term
CSDS1    = 0.0                             ! 
CT0      = 0.0                             ! No Jmunu terms
CT1      = 0.0                             ! 
coultreatment=0
/


