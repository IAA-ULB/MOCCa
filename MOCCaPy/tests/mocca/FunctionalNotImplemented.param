!-------------------------------------------------------------------------------
! FunctionalNotImplemented parameterization
!
! This is a .param file to test that an AssertionError is raised when the
! functional is not implemented.
!-------------------------------------------------------------------------------
&skf 
name     = "FunctionalNotImplemented"
func_file= 'FunctionalNotImplemented.func'
p1 = 1
p2 = 2.0
p3 = 3e-9
p4 = 'str'
p5 = "str"
p6 = 6.0, 6.0
p7 = 7, p8 = 8
p11 = 11,
p12 = 12.0,
p13 = 13e-9,
p14 = 'str',
p15 = "str",
p16 = 16., 16.,
p17 = 17, p18 = 18,
p19 = .true. ! comment
p20 = .false. ! comment

! empty line with comment
/
