# Dockerfile for MOCCa CI/CD with Intel OneAPI compilers
# 
# This image contains Intel OneAPI compilers (ifx, icx, mpiifx) and all
# build and runtime dependencies for MOCCa.
#
# Usage in workflows:
#   jobs:
#     compile:
#       runs-on: ubuntu-latest
#       container: ghcr.io/iaa-ulb/mocca-ci-oneapi:latest
#
# Build and push commands:
#   docker build -t ghcr.io/iaa-ulb/mocca-ci-oneapi:latest -f .github/docker/Dockerfile.oneapi .
#   docker push ghcr.io/iaa-ulb/mocca-ci-oneapi:latest

FROM intel/oneapi-toolkit:2026.1.0-devel-ubuntu26.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install all dependencies in one layer to minimize image size
# Note: The Intel OneAPI base image already has ifx, icx, mpiifx, and MKL configured
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
        make git \
        libhdf5-dev hdf5-tools \
        python3 python3-pip python3-numpy python3-scipy \
        time bc ca-certificates \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*


# Set up working directory
WORKDIR /workspace

# Source Intel OneAPI environment to ensure all variables are set
# We source setvars.sh in the same RUN command to capture environment for verification
RUN /bin/bash -c " \
    echo '=== Intel OneAPI Environment Verification ===' && \
    ifx --version && \
    icx --version && \
    python3 -c 'import numpy; import scipy; print(\"scipy version:\", scipy.__version__)' && \
    h5cc --version && \
    echo 'All verifications passed!'"

# Label the image
LABEL maintainer="wouter.ryssens@ulb.be"
LABEL description="MOCCa CI/CD environment with Intel OneAPI compilers and all dependencies pre-installed"
